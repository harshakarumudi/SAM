# ============================================================
# SMART AGRICULTURE MONITORING SYSTEM - ENVIRONMENT CONFIG
# ============================================================

# Environment: development / production / testing
ENVIRONMENT=development
DEBUG=true

# Database Configuration (PostgreSQL / SQLite fallback)
DATABASE_URL=postgresql://agri_user:agri_secure_pass@localhost:5432/agri_db
# For zero-dependency local test run: sqlite:///./agri_dev.db
# DATABASE_URL=sqlite:///./agri_dev.db

# JWT & Security
SECRET_KEY=CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY_MIN_32_BYTES_IN_PROD
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# MQTT Broker Configuration
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_USER=backend_service
MQTT_PASSWORD=backend_secure_mqtt_pass
MQTT_CLIENT_ID=agri_backend_core
MQTT_KEEPALIVE=60

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
LOGIN_RATE_LIMIT_PER_MINUTE=10

# Actuator Safety Limits
MAX_PUMP_RUNTIME_SECONDS=600
SENSOR_WATCHDOG_TIMEOUT_SECONDS=60

# Weather API (Optional external; simulated provider is used if key is blank)
WEATHER_API_KEY=
WEATHER_LOCATION=Farm_Sector_Alpha
